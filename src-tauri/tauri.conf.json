{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColdShot",
  "version": "0.4.0",
  "identifier": "com.coldwork.coldshot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ColdShot",
        "width": 860,
        "height": 620,
        "minWidth": 460,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast screenshot capture, annotation and sharing",
    "longDescription": "ColdShot captures an area, a window or a full screen, annotates the result and copies, saves or pins it. It lives in the system tray with global hotkeys.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
